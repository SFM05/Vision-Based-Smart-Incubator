# ESP32-P4 硬件修订版本配置
# 您的硬件版本为 ECO 1.3 (rev 1.3)，属于 v1.x 分支
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP32P4_REV_MIN_FULL=100
CONFIG_ESP_REV_MIN_FULL=100
CONFIG_ESP32P4_REV_MAX_FULL=199
CONFIG_ESP_REV_MAX_FULL=199

# PSRAM 配置 (ESP32-P4 HEX 模式, 200MHz)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_SPEED=200
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# 摄像头传感器 (OV5647, MIPI CSI 接口) → 1920x1080 16:9 全高清
CONFIG_CAMERA_OV5647=y
CONFIG_CAMERA_OV5647_AUTO_DETECT=y
CONFIG_CAMERA_OV5647_MIPI_RAW10_1920x1080_30FPS=y
CONFIG_CAMERA_OV5647_MIPI_IF_FORMAT_INDEX_DAFAULT=3

# WiFi Remote (通过 C5 协处理器实现 WiFi 功能)
CONFIG_ESP_WIFI_REMOTE_ENABLED=y

# C5 协处理器目标（覆盖 P4 默认的 C6）
CONFIG_SLAVE_IDF_TARGET_ESP32C5=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C5=y
CONFIG_ESP_HOSTED_IDF_SLAVE_TARGET="esp32c5"

# ESP32-P4 作为 Host，不需要 ITWT（由 C5 从机处理）
# CONFIG_ESP_HOSTED_ENABLE_ITWT is not set

# 大分区表（esp_hosted 使固件 >1MB）
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# 禁用任务看门狗（SPI 长传输会抢占 IDLE）
CONFIG_ESP_TASK_WDT=n

# MQTT 客户端缓冲区大小 (JPEG/Base64 负载可达 60KB 以上)
CONFIG_MQTT_BUFFER_SIZE=65536


# LVGL 字体
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y

# Camera XCLK
CONFIG_CAMERA_XCLK_USE_ESP_CLOCK_ROUTER=y
